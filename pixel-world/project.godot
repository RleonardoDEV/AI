; PIXEL WORLD - Godot 4.x project configuration
; Engine configuration file.

config_version=5

[application]

config/name="PIXEL WORLD"
config/description="A living, self-evolving pixel-art ecosystem."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.027451, 0.031373, 0.058824, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.svg"

[autoload]

EventBus="*res://core/event_bus.gd"
Config="*res://core/config.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.027451, 0.031373, 0.058824, 1)
2d/snap/snap_2d_transforms_to_pixel=false
textures/vram_compression/import_etc2_astc=true
