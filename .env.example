# =====================================================================
#  AI Project Manager Assistant - configuración local
#  Copia este fichero a .env y rellena los valores.
#  NUNCA subas .env al repositorio. NUNCA pongas secretos en el código.
# =====================================================================

APP_ENV=local
LOG_LEVEL=INFO

# Prohibido poner true fuera de depuración local: registraría contenido
# de documentos corporativos en los logs.
LOG_DOCUMENT_CONTENT=false

# ── Microsoft Entra ID ───────────────────────────────────────────────
# Los proporciona IT tras crear los dos App Registrations (docs/07).
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=
AZURE_API_CLIENT_SECRET=
AZURE_SPA_CLIENT_ID=

# Ámbitos delegados solicitados a Graph mediante On-Behalf-Of.
# Decisión ADR-011: Sites.Selected acotado al sitio del PoC.
# NO añadir Files.Read.All ni Sites.Read.All: anularían Sites.Selected.
GRAPH_SCOPES=https://graph.microsoft.com/Sites.Selected

# ── Recuperación documental ──────────────────────────────────────────
# local = pgvector propio | m365 = Retrieval API de Microsoft 365 Copilot
RETRIEVAL_PROVIDER=local

# ── Modelo de lenguaje ───────────────────────────────────────────────
# fake = cliente determinista para tests, no llama a ningún servicio
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_SYNTHESIS=
LLM_MODEL_EXTRACTION=
LLM_MODEL_ANALYSIS=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# ── Base de datos ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aipm:aipm@localhost:5432/aipm

# ── Retención y límites ──────────────────────────────────────────────
AUDIT_RETENTION_DAYS=365
CHUNK_RETENTION_DAYS=180
MAX_EVIDENCE_PER_ANSWER=12
QUARANTINE_RATIO_UNKNOWN=0.20
